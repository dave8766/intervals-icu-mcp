# Intervals.icu API Credentials
# Get these from https://intervals.icu/settings

# Your API key (found in Developer section of settings)
INTERVALS_ICU_API_KEY=your_api_key_here

# Your athlete ID (format: i123456, found in your profile URL)
INTERVALS_ICU_ATHLETE_ID=i123456

# Optional: include `fetched_at` + `query_type` in every response's metadata
# block. Off by default to keep responses compact; enable for debugging.
# INTERVALS_ICU_DEBUG_METADATA=false

# --- Remote (HTTP transport) access control ---------------------------------
# Only relevant when serving over HTTP; stdio is protected by the OS.
# Default is `none`. Set to `github` to require GitHub OAuth.
# The allowlist is mandatory in github mode: without it every GitHub account
# in the world authenticates successfully. See docs/remote-deployment.md.
# INTERVALS_ICU_AUTH=github
# INTERVALS_ICU_AUTH_GITHUB_CLIENT_ID=your_oauth_app_client_id
# INTERVALS_ICU_AUTH_GITHUB_CLIENT_SECRET=your_oauth_app_client_secret
# INTERVALS_ICU_AUTH_ALLOWED_GITHUB_USERS=your-github-login
# Public https:// URL of the deployment (auto-detected on Railway).
# INTERVALS_ICU_AUTH_BASE_URL=https://your-app.up.railway.app
